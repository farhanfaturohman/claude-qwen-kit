#!/usr/bin/env python3
"""Ikuti file progres Qwen: cetak tiap baris baru, keluar saat baris '■ SELESAI' muncul.
Pakai (di Monitor): qwen-ikuti <progres.txt>
"""
import os
import sys
import time

p = sys.argv[1]
while not os.path.exists(p):
    time.sleep(0.5)
pos = 0
sisa = ""
while True:
    with open(p, encoding="utf-8", errors="replace") as f:
        f.seek(pos)
        data = f.read()
        pos = f.tell()
    if data:
        sisa += data
        *baris, sisa = sisa.split("\n")
        for b in baris:
            print(b, flush=True)
            if b.startswith("■ SELESAI"):
                sys.exit(0)
    time.sleep(0.7)
